<launch>
  <!-- config: a name in config/ (kitti, ouster64, radar_4d) or a path to a YAML file -->
  <arg name="config" default="kitti" />
  <arg name="cloud_topic" default="/cloud" />
  <arg name="odom_topic" default="/odom" />
  <arg name="save_dir" default="" />
  <arg name="rviz" default="true" />

  <arg name="config_dir" value="$(dirname)/../../../config" />

  <node pkg="solid_ros" type="solid_node" name="solid" output="screen" required="true">
    <param name="config" value="$(arg config_dir)/$(arg config).yaml"
           unless="$(eval '/' in arg('config'))" />
    <param name="config" value="$(arg config)" if="$(eval '/' in arg('config'))" />
    <param name="save_dir" value="$(arg save_dir)" />
    <remap from="cloud" to="$(arg cloud_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="solid_rviz"
        args="-d $(dirname)/../rviz/solid.rviz">
    <env name="DISABLE_ROS1_EOL_WARNINGS" value="1" />  <!-- no Noetic end-of-life dialog over the view -->
  </node>
</launch>
