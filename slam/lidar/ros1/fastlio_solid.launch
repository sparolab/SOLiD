<launch>
  <!-- FAST-LIO (hku-mars, ROS 1) + SOLiD loop candidates.
       The FAST-LIO body frame is the IMU frame; on Kimera-Multi that is the RealSense optical
       frame (z forward), so SOLiD gets the raw LiDAR scan (velodyne frame, z up) instead of
       /cloud_registered_body. /Odometry is only used for keyframe spacing. -->
  <arg name="fastlio_config" default="$(dirname)/fast_lio_kimera_sparkal1.yaml" />
  <arg name="solid_config" default="$(dirname)/../config/kimera_sparkal1.yaml" />
  <arg name="cloud_topic" default="/sparkal1/lidar_points" />
  <arg name="odom_topic" default="/Odometry" />
  <arg name="save_dir" default="" />
  <arg name="rviz" default="true" />

  <rosparam command="load" file="$(arg fastlio_config)" />
  <param name="feature_extract_enable" type="bool" value="0" />
  <param name="point_filter_num" type="int" value="4" />
  <param name="max_iteration" type="int" value="3" />
  <param name="filter_size_surf" type="double" value="0.5" />
  <param name="filter_size_map" type="double" value="0.5" />
  <param name="cube_side_length" type="double" value="1000" />
  <param name="runtime_pos_log_enable" type="bool" value="0" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="log" />

  <include file="$(find solid_ros)/launch/solid.launch">
    <arg name="config" value="$(arg solid_config)" />
    <arg name="cloud_topic" value="$(arg cloud_topic)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="save_dir" value="$(arg save_dir)" />
    <arg name="rviz" value="$(arg rviz)" />
  </include>
</launch>
