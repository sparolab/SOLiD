FROM ros:humble-perception

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libeigen3-dev libyaml-cpp-dev ros-humble-gtsam ros-humble-rviz2 \
    && rm -rf /var/lib/apt/lists/*

COPY . /ros2_ws/src/SOLiD

# 1. The SOLiD library (cpp/): solid::core, solid::slam, solid::backend.
RUN . /opt/ros/humble/setup.sh \
    && cmake -S /ros2_ws/src/SOLiD/cpp -B /tmp/solid_build -DCMAKE_BUILD_TYPE=Release \
      -DSOLID_USE_PCL=OFF -DSOLID_BUILD_BACKEND=ON \
    && cmake --build /tmp/solid_build -j4 && cmake --install /tmp/solid_build && rm -rf /tmp/solid_build

# 2. ROS 2 packages find it with find_package(solid). --base-paths skips the ROS 1 packages.
WORKDIR /ros2_ws
RUN . /opt/ros/humble/setup.sh && \
    colcon build --base-paths src/SOLiD/ros2 \
      --parallel-workers 2 --cmake-args -DCMAKE_BUILD_TYPE=Release

RUN echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc
CMD ["bash"]
