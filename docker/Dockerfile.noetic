FROM osrf/ros:noetic-desktop-full

ENV DEBIAN_FRONTEND=noninteractive
# GTSAM 4.0 from the borglab PPA (multi-session SLAM); Eigen, PCL and yaml-cpp come with ROS.
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y ppa:borglab/gtsam-release-4.0 && apt-get update \
    && apt-get install -y --no-install-recommends \
       libeigen3-dev libyaml-cpp-dev libgtsam-dev libgtsam-unstable-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /catkin_ws/src/SOLiD

# 1. The SOLiD library (cpp/): solid::core, solid::slam, solid::backend.
RUN cmake -S /catkin_ws/src/SOLiD/cpp -B /tmp/solid_build -DCMAKE_BUILD_TYPE=Release \
      -DSOLID_USE_PCL=OFF -DSOLID_BUILD_BACKEND=ON \
    && cmake --build /tmp/solid_build -j4 && cmake --install /tmp/solid_build && rm -rf /tmp/solid_build

# 2. The ROS 1 package (slam/common/ros1, solid_ros) finds it with find_package(solid).
#    The ROS 2 packages carry CATKIN_IGNORE.
WORKDIR /catkin_ws
RUN . /opt/ros/noetic/setup.sh && catkin_make -DCMAKE_BUILD_TYPE=Release -j4

RUN echo "source /catkin_ws/devel/setup.bash" >> /root/.bashrc
CMD ["bash"]
