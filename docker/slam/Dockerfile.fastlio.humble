# FAST-LIO (ROS 2 branch of hku-mars/FAST_LIO) + livox_ros_driver2 + SOLiD.
#   docker build -t solid:humble -f docker/Dockerfile.humble .
#   docker build -t solid-fastlio:humble -f docker/slam/Dockerfile.fastlio.humble .
FROM solid:humble
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential \
      libpcl-dev ros-humble-pcl-conversions \
    && rm -rf /var/lib/apt/lists/*
# Livox-SDK2 + livox_ros_driver2 (FAST-LIO's ROS 2 branch uses livox_ros_driver2/CustomMsg).
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /opt/Livox-SDK2 && \
    cd /opt/Livox-SDK2 && mkdir build && cd build && cmake .. && make -j4 && make install
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git /ros2_ws/src/livox_ros_driver2 && \
    cd /ros2_ws/src/livox_ros_driver2 && cp package_ROS2.xml package.xml
RUN git clone --branch ROS2 https://github.com/hku-mars/FAST_LIO.git /ros2_ws/src/FAST_LIO && \
    cd /ros2_ws/src/FAST_LIO && git submodule update --init
WORKDIR /ros2_ws
RUN . /opt/ros/humble/setup.sh && \
    colcon build --base-paths src/livox_ros_driver2 src/FAST_LIO --parallel-workers 2 \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DROS_EDITION=ROS2 -DDISTRO_ROS=humble
CMD ["bash"]
