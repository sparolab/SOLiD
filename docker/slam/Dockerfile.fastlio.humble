# FAST-LIO (ROS 2 branch, thirdparty/FAST_LIO_ROS2) + livox_ros_driver2 + SOLiD.
#   docker build -f docker/Dockerfile.humble -t solid:humble .
#   docker build -t solid-fastlio:humble -f docker/slam/Dockerfile.fastlio.humble .
FROM solid:humble
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential \
      libpcl-dev ros-humble-pcl-conversions \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /opt/Livox-SDK2 && \
    cd /opt/Livox-SDK2 && mkdir build && cd build && cmake .. && make -j4 && make install
# livox_ros_driver2 ships one package.xml per ROS version
RUN cp -r /ros2_ws/src/SOLiD/thirdparty/livox_ros_driver2 /ros2_ws/src/ && \
    cp /ros2_ws/src/livox_ros_driver2/package_ROS2.xml /ros2_ws/src/livox_ros_driver2/package.xml
WORKDIR /ros2_ws
RUN . /opt/ros/humble/setup.sh && \
    colcon build --base-paths src/livox_ros_driver2 src/SOLiD/thirdparty/FAST_LIO_ROS2 --parallel-workers 2 \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DROS_EDITION=ROS2 -DDISTRO_ROS=humble
CMD ["bash"]
