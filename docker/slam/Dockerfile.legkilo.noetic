# Leg-KILO (kinematic-inertial-LiDAR odometry for legged robots, thirdparty/Leg-KILO) + SOLiD.
# Leg-KILO always opens its own viewer: without a display, run it under `xvfb-run -a`.
#   docker build -t solid-legkilo:noetic -f docker/slam/Dockerfile.legkilo.noetic .
# Base: the published SOLiD image (or a local build: --build-arg BASE=solid:noetic)
ARG BASE=ghcr.io/sparolab/solid:noetic
FROM ${BASE}
# The odometry sources come from this checkout (git submodule update --init --recursive).
COPY thirdparty /catkin_ws/src/SOLiD/thirdparty
RUN test -n "$(ls -A /catkin_ws/src/SOLiD/thirdparty/Leg-KILO)" || (echo "thirdparty/ is empty: run git submodule update --init --recursive" && exit 1)
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git \
      libeigen3-dev libpcl-dev libgoogle-glog-dev libgflags-dev libyaml-cpp-dev \
      libboost-filesystem-dev libboost-system-dev libtbb-dev liblz4-dev libceres-dev libglm-dev libglfw3-dev \
      xvfb libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*
RUN cp -r /catkin_ws/src/SOLiD/thirdparty/Leg-KILO /catkin_ws/src/Leg-KILO
WORKDIR /catkin_ws
RUN . /opt/ros/noetic/setup.sh && catkin_make -DCMAKE_BUILD_TYPE=Release -j4
CMD ["bash"]
