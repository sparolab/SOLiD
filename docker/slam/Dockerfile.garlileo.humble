# GaRLILEO (radar-leg-inertial odometry for legged robots, ROS 2) + SOLiD.
# GaRLILEO builds its own Eigen, PCL, Ceres, Sophus and Pangolin, so start from its image:
#   docker build -t garlileo-deps https://github.com/ChiyunNoh/GaRLILEO.git#main:docker
#   docker build -t solid-garlileo:humble -f docker/slam/Dockerfile.garlileo.humble .
ARG BASE=garlileo-deps
FROM ${BASE}
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
# solid::backend links GaRLILEO's own PCL build; GTSAM comes from the ROS apt repo.
# (only solid_ros is built here; for multi-session (tools/multi-session-slam, needs pcl_conversions)
#  use ghcr.io/sparolab/solid:humble.)
RUN apt-get update && apt-get install -y --no-install-recommends libyaml-cpp-dev mpi-default-dev \
      ros-humble-message-filters ros-humble-gtsam \
    && rm -rf /var/lib/apt/lists/*
COPY . /root/ros2_ws/src/SOLiD
# 1. SOLiD library
RUN source /opt/ros/humble/setup.bash && \
    cmake -S /root/ros2_ws/src/SOLiD/cpp -B /tmp/solid_build -DCMAKE_BUILD_TYPE=Release \
      -DSOLID_USE_PCL=OFF -DSOLID_BUILD_BACKEND=ON -DSOLID_BUILD_EXAMPLES=OFF -DBUILD_SOLID_VERIFY=OFF && \
    cmake --build /tmp/solid_build -j4 && cmake --install /tmp/solid_build && rm -rf /tmp/solid_build
# 2. GaRLILEO + SPOT_ego_Velocity (leg velocity)
# GaRLILEO + SPOT_ego_Velocity from thirdparty/ (git submodule update --init --recursive)
RUN git config --global --add safe.directory '*' && \
    cp -r /root/ros2_ws/src/SOLiD/thirdparty/GaRLILEO /root/ros2_ws/src/GaRLILEO && \
    cp -r /root/ros2_ws/src/SOLiD/thirdparty/SPOT_ego_Velocity /root/ros2_ws/src/SPOT_ego_Velocity && \
    cd /root/ros2_ws/src/GaRLILEO && \
    # the submodules are already in the build context (no .git there): skip the scripts' `git submodule update`
    sed -i '/git submodule update/,/^fi$/d' build_thirdparty.sh thirdparty/ctraj/build_thirdparty.sh && \
    bash build_thirdparty.sh
# magic_enum >= 0.9.6 moved the bitwise operators to their own header.
RUN sed -i 's#^\#include <magic_enum.hpp>#\#include <magic_enum.hpp>\n\#if __has_include(<magic_enum/magic_enum_bitwise.hpp>)\n\#include <magic_enum/magic_enum_bitwise.hpp>\n\#endif#' \
      /root/ros2_ws/src/GaRLILEO/include/util/enum_cast.hpp
WORKDIR /root/ros2_ws
RUN source /opt/ros/humble/setup.bash && \
    colcon build --base-paths src/GaRLILEO src/SPOT_ego_Velocity src/SOLiD/slam/common/ros2 \
      --parallel-workers 2 --cmake-args -DCMAKE_BUILD_TYPE=Release
RUN echo "source /root/ros2_ws/install/setup.bash" >> /root/.bashrc
ENTRYPOINT []
CMD ["bash"]
