# FAST-LIO (ROS 1, thirdparty/FAST_LIO) + SOLiD: Velodyne/Ouster LiDARs and the Livox Mid-360 humanoid (KILVO).
#   git submodule update --init --recursive
#   docker build -f docker/slam/Dockerfile.fastlio.noetic -t solid-fastlio:noetic .
# Base: the published SOLiD image (or a local build: --build-arg BASE=solid:noetic)
ARG BASE=ghcr.io/sparolab/solid:noetic
FROM ${BASE}
# The odometry sources come from this checkout (git submodule update --init --recursive).
COPY thirdparty /catkin_ws/src/SOLiD/thirdparty
RUN test -n "$(ls -A /catkin_ws/src/SOLiD/thirdparty/FAST_LIO)" && test -n "$(ls -A /catkin_ws/src/SOLiD/thirdparty/livox_ros_driver)" || (echo "thirdparty/ is empty: run git submodule update --init --recursive" && exit 1)
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential \
    && rm -rf /var/lib/apt/lists/*
# FAST-LIO needs livox_ros_driver/CustomMsg, which needs the Livox SDK.
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK.git /opt/Livox-SDK && \
    cd /opt/Livox-SDK/build && cmake .. && make -j4 && make install
RUN cp -r /catkin_ws/src/SOLiD/thirdparty/livox_ros_driver /catkin_ws/src/ && \
    cp -r /catkin_ws/src/SOLiD/thirdparty/FAST_LIO /catkin_ws/src/
WORKDIR /catkin_ws
RUN . /opt/ros/noetic/setup.sh && catkin_make -DCMAKE_BUILD_TYPE=Release -j4
CMD ["bash"]
