<?xml version="1.0"?>
<package format="3">
  <name>solid_multi_session</name>
  <version>0.1.0</version>
  <description>Multi-session SLAM with SOLiD: aligns sessions saved by the SOLiD nodes (ROS 2).</description>
  <maintainer email="hg.kim@inha.edu">Hogyun Kim</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>gtsam</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
