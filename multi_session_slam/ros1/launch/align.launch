<launch>
  <!-- sessions: space-separated session folders; the first one is the central session -->
  <arg name="sessions" />
  <arg name="config" default="$(find solid_multi_session)/../config/default.yaml" />
  <arg name="save_dir" default="" />
  <arg name="rviz" default="true" />

  <node pkg="solid_multi_session" type="align_node" name="solid_multi_session" output="screen">
    <param name="sessions" value="$(arg sessions)" />
    <param name="config" value="$(arg config)" />
    <param name="save_dir" value="$(arg save_dir)" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="solid_ms_rviz"
        args="-d $(find solid_multi_session)/rviz/align.rviz" />
</launch>
